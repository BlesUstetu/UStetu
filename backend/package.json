{
  "name": "ustetu-marketplace-indexer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/indexer.ts",
    "api": "tsx src/api.ts",
    "keeper": "tsx src/expiryKeeper.ts",
    "keeper:once": "tsx -e \"import { runOnce } from './src/expiryKeeper.ts'; await runOnce();\"",
    "start": "node dist/indexer.js",
    "start:api": "node dist/api.js",
    "start:keeper": "node dist/expiryKeeper.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
