# WalletConnect Cloud project ID
# Optional for local development; USTETU also has a public fallback project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional marketplace indexer.
# If this is empty, the frontend uses the verified on-chain bootstrap listing #1
# so users can transact directly while the indexer is being finalized.
NEXT_PUBLIC_USTETU_INDEXER_API_URL=
